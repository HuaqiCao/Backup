swModelView.RollBy 0

' New Document
Dim swSheetWidth As Double
swSheetWidth = 1.189000000000000057
Dim swSheetHeight As Double
swSheetHeight = 0.8409999999999999698
Set Part = swApp.NewDocument("C:\ProgramData\SolidWorks\SOLIDWORKS 2025\templates\gb_a0.drwdot", 12, swSheetWidth, swSheetHeight)
Dim swDrawing As DrawingDoc
Set swDrawing = Part
Set swDrawing = Part
Dim swSheet As sheet
Set swSheet = swDrawing.GetCurrentSheet()
swSheet.SetProperties2 12, 12, 2, 1, False, swSheetWidth, swSheetHeight, True
swSheet.SetTemplateName "v:\updated cs\a0 - gb.slddrt"
swSheet.ReloadTemplate True
boolstatus = Part.GenerateViewPaletteViews("C:\Users\Administrator\Desktop\三轴块\update.SLDPRT")
boolstatus = Part.Create3rdAngleViews("C:\Users\Administrator\Desktop\三轴块\update.SLDPRT")
Dim vAnnotations As Variant
vAnnotations = Part.InsertModelAnnotations3(0, 29000191, True, True, False, True)

' Zoom To Fit
Part.ViewZoomtofit2
